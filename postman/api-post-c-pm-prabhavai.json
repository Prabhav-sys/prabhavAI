{
  "info": {
    "_postman_id": "c1d9e8d2-8d15-447f-8606-682a4b8f0612",
    "name": "prabhavAI API smoke tests",
    "description": "Read-only API smoke tests for the interview preparation platform. Set baseUrl and firebaseIdToken before running. The payment order request expects HTTP 503 when Razorpay is not configured; it does not attempt checkout or charge a payment method.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{firebaseIdToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "serverUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "firebaseIdToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "razorpayConfigured",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Backend liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{serverUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Backend is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property('success', true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authenticated user",
      "item": [
        {
          "name": "Credit wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/credits/wallet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wallet returns a non-negative balance', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.balance).to.be.a('number').and.at.least(0);",
                  "    pm.expect(data.lots).to.be.an('array');",
                  "    pm.expect(data.transactions).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Credit pricing",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/credits/pricing"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pricing includes interview lengths and packages', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.features.interview).to.have.property('5', 30);",
                  "    pm.expect(data.features.interview).to.have.property('10', 50);",
                  "    pm.expect(data.features.interview).to.have.property('20', 85);",
                  "    pm.expect(data.packages).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard exposes live metrics and activity', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.metrics).to.have.property('availableCredits');",
                  "    pm.expect(data.metrics).to.have.property('completedInterviewCount');",
                  "    pm.expect(data.interviewTrend).to.be.an('array');",
                  "    pm.expect(data.recentActivity).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resume history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/resumes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resume history is scoped and returned as a list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Job-fit history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/job-matching"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job-fit history is returned as a list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Interview history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interviews/sessions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview history is returned as a list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment package configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/packages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment configuration is explicit', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.provider).to.eql('RAZORPAY');",
                  "    pm.expect(data.mode).to.be.oneOf(['test', 'live']);",
                  "    pm.expect(data.configured).to.be.a('boolean');",
                  "    pm.collectionVariables.set('razorpayConfigured', String(data.configured));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Razorpay test-mode configuration (no payment)",
      "item": [
        {
          "name": "Create a test order or confirm checkout is disabled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": \"starter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order creation follows Razorpay configuration state', function () {",
                  "    if (pm.collectionVariables.get('razorpayConfigured') === 'true') {",
                  "        pm.response.to.have.status(201);",
                  "        pm.expect(pm.response.json().data.orderId).to.be.a('string');",
                  "    } else {",
                  "        pm.response.to.have.status(503);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin (requires an admin Firebase token)",
      "item": [
        {
          "name": "Admin dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin dashboard returns protected platform metrics', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.metrics).to.have.property('totalUsers');",
                  "    pm.expect(data).to.have.property('recentUsers').that.is.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users?page=1&limit=10&sortBy=createdAt&order=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin user list is paginated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data).to.be.an('array');",
                  "    pm.expect(response.meta.totalUsers).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
