NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/interview_ai
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path/to/firebase-service-account.json
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=replace-with-the-same-INTERNAL_API_KEY-from-ai-service
MAX_RESUME_SIZE_MB=5

# Razorpay test credentials. Purchase endpoints stay unavailable until configured.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret