APP_NAME=prabhavAI AI Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Generate a strong random value. Node backend must send this as X-Internal-API-Key.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Groq uses an OpenAI-compatible API. Rotate the key previously pasted into chat.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60

# Qdrant Cloud. The endpoint is prefilled from the cluster URL you supplied.
QDRANT_URL=https://d6b7c5a1-01c2-435a-9a28-c2bf3c8cac55.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=prabhavai_resume_chunks

# FastEmbed downloads this model on first use; vector size is 384.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Rotate the Tavily key previously pasted into chat before adding its replacement.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Optional Weaviate integration. Not used unless explicitly configured.
WEAVIATE_ENABLED=false
WEAVIATE_URL=
WEAVIATE_API_KEY=

MAX_UPLOAD_SIZE_MB=5
MAX_PDF_PAGES=40
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
